{
    "name": "@spacexr/3d-tiles-core",
    "version": "0.1.0",
    "description": "Implementation-neutral TypeScript interfaces, JSON codecs and validation for OGC 3D Tiles.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/3d-tiles-core.git",
        "directory": "node/packages/core"
    },
    "homepage": "https://github.com/pandaGaume/3d-tiles-core#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/3d-tiles-core/issues"
    },
    "keywords": [
        "3d-tiles",
        "ogc",
        "gltf",
        "geospatial",
        "tileset",
        "spacexr"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./model": {
            "types": "./dist/model/index.d.ts",
            "import": "./dist/model/index.js",
            "default": "./dist/model/index.js"
        },
        "./codecs": {
            "types": "./dist/codecs/index.d.ts",
            "import": "./dist/codecs/index.js",
            "default": "./dist/codecs/index.js"
        },
        "./validation": {
            "types": "./dist/validation/index.d.ts",
            "import": "./dist/validation/index.js",
            "default": "./dist/validation/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist coverage",
        "watch": "tsup --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.1.3",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2",
        "vitest": "5.0.1"
    }
}
