{
    "name": "@spacexr/3d-tiles-runtime",
    "version": "0.1.0",
    "description": "Renderer-neutral 3D Tiles traversal, content lifecycle and metadata runtime.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/3d-tiles-core.git",
        "directory": "node/packages/runtime"
    },
    "homepage": "https://github.com/pandaGaume/3d-tiles-core#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/3d-tiles-core/issues"
    },
    "keywords": [
        "3d-tiles",
        "runtime",
        "gltf",
        "geospatial",
        "metadata",
        "spacexr"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./implicit": {
            "types": "./dist/implicit/index.d.ts",
            "import": "./dist/implicit/index.js",
            "default": "./dist/implicit/index.js"
        },
        "./ports": {
            "types": "./dist/ports/index.d.ts",
            "import": "./dist/ports/index.js",
            "default": "./dist/ports/index.js"
        },
        "./metadata": {
            "types": "./dist/metadata/index.d.ts",
            "import": "./dist/metadata/index.js",
            "default": "./dist/metadata/index.js"
        },
        "./pipeline": {
            "types": "./dist/pipeline/index.d.ts",
            "import": "./dist/pipeline/index.js",
            "default": "./dist/pipeline/index.js"
        },
        "./spatial": {
            "types": "./dist/spatial/index.d.ts",
            "import": "./dist/spatial/index.js",
            "default": "./dist/spatial/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist coverage",
        "watch": "tsup --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@spacexr/3d-tiles-core": "0.1.0",
        "@spacexr/geodesy": "0.2.0",
        "@spacexr/tiles": "0.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.1.3",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "4.1.11"
    }
}
