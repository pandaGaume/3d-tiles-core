{
    "name": "@spacexr/tiles",
    "version": "0.1.0",
    "description": "Renderer-neutral web tile addressing, tile sources and DEM codecs for XYZ, TMS and quadkey pyramids.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/3d-tiles-core.git",
        "directory": "node/packages/tiles"
    },
    "homepage": "https://github.com/pandaGaume/3d-tiles-core#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/3d-tiles-core/issues"
    },
    "keywords": [
        "tiles",
        "xyz",
        "tms",
        "quadkey",
        "web-mercator",
        "dem",
        "terrarium",
        "terrain-rgb",
        "spacexr"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./addressing": {
            "types": "./dist/addressing/index.d.ts",
            "import": "./dist/addressing/index.js",
            "default": "./dist/addressing/index.js"
        },
        "./sources": {
            "types": "./dist/sources/index.d.ts",
            "import": "./dist/sources/index.js",
            "default": "./dist/sources/index.js"
        },
        "./codecs": {
            "types": "./dist/codecs/index.d.ts",
            "import": "./dist/codecs/index.js",
            "default": "./dist/codecs/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist coverage",
        "watch": "tsup --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@spacexr/geodesy": "0.2.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.0.1",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "4.1.11"
    }
}
