{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@spacexr/3d-tiles-core": ["../../packages/core/src/index.ts"],
            "@spacexr/3d-tiles-runtime": ["../../packages/runtime/src/index.ts"]
        },
        "types": ["vite/client", "vitest/globals"]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts"
    ]
}
