{
    "name": "@spacexr/example-babylon-implicit-geodesic-grid",
    "version": "0.1.0",
    "private": true,
    "description": "Babylon.js proof of the renderer-neutral 3D Tiles pipeline with ellipsoid-projected geodesic grids.",
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" --fix",
        "format": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.{ts,json,md,html}\"",
        "format:fix": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.{ts,json,md,html}\"",
        "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@babylonjs/core": "^9.28.0",
        "@spacexr/3d-tiles-core": "0.1.0",
        "@spacexr/3d-tiles-runtime": "0.1.0",
        "@spacexr/geodesy": "0.2.0",
        "@spacexr/tiles": "0.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "typescript": "^5.4.0",
        "vite": "^6.4.4",
        "vitest": "4.1.11"
    }
}
