{
    "folders": [
        { "name": "3D Tiles Core", "path": "." },
        { "name": "Node core", "path": "node/packages/core" },
        { "name": ".NET", "path": "dotnet" },
        { "name": "C++ and Unreal", "path": "cpp" }
    ],
    "settings": {
        "files.exclude": {
            "**/node_modules": true,
            "**/bin": true,
            "**/obj": true,
            "**/dist": true,
            "**/build": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/bin": true,
            "**/obj": true,
            "**/build": true
        },
        "typescript.tsdk": "node/node_modules/typescript/lib",
        "eslint.workingDirectories": [
            { "directory": "node/packages/core", "changeProcessCWD": true }
        ],
        "files.eol": "\n"
    },
    "extensions": {
        "recommendations": [
            "dbaeumer.vscode-eslint",
            "esbenp.prettier-vscode",
            "ms-dotnettools.csharp",
            "ms-dotnettools.csdevkit",
            "ms-vscode.cpptools",
            "editorconfig.editorconfig"
        ]
    }
}

